# The compose file has defaults for these two domains.
APP_DOMAIN=walkietalkiepro.in
LIVEKIT_DOMAIN=rtc.walkietalkiepro.in

# Generate unique secrets before deployment. Do not commit real values.
LIVEKIT_API_KEY=replace-with-a-unique-key
LIVEKIT_API_SECRET=replace-with-a-long-random-secret
APP_SESSION_SECRET=replace-with-at-least-48-random-characters
